---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---
<BaseLayout title="Home">
  <div class="flex flex-col items-center text-center py-12 md:py-20">
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight mb-4">DocPrep</h1>
    <p class="text-xl text-text-muted mb-12 max-w-2xl">The PYQ bank AIIMS Patna deserves.</p>
    
    <SearchBox />
  </div>

  <div class="mt-8 space-y-12">
    <section>
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path></svg>
        Browse by Professional Year
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {['1st', '2nd', '3rd', 'Final'].map(year => (
          <a href={`/browse?year=${year}`} class="bg-bg-elevated border border-border p-6 rounded-xl text-center hover:border-accent hover:shadow-md transition-all group">
            <h3 class="text-lg font-bold group-hover:text-accent transition-colors">{year} Year</h3>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Browse by Subject
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <a href="/browse/physiology" class="bg-bg-elevated border border-border p-6 rounded-xl hover:border-accent hover:shadow-md transition-all group">
          <h3 class="text-lg font-bold group-hover:text-accent transition-colors">Physiology</h3>
          <p class="text-sm text-text-muted mt-2">1st Year</p>
        </a>
        <a href="/browse/anatomy" class="bg-bg-elevated border border-border p-6 rounded-xl hover:border-accent hover:shadow-md transition-all group">
          <h3 class="text-lg font-bold group-hover:text-accent transition-colors">Anatomy</h3>
          <p class="text-sm text-text-muted mt-2">1st Year</p>
        </a>
        <a href="/browse/biochemistry" class="bg-bg-elevated border border-border p-6 rounded-xl hover:border-accent hover:shadow-md transition-all group">
          <h3 class="text-lg font-bold group-hover:text-accent transition-colors">Biochemistry</h3>
          <p class="text-sm text-text-muted mt-2">1st Year</p>
        </a>
      </div>
    </section>
  </div>

  <div class="mt-20 text-center">
    <a href="/admin" class="text-sm text-text-faint hover:text-text transition-colors">Log in to save questions</a>
  </div>
</BaseLayout>
