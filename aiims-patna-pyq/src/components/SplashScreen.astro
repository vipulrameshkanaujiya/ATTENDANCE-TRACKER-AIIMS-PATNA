---
<div id="splash-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-bg flex-col transition-opacity duration-500">
  <div class="animate-pulse flex flex-col items-center">
    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-4">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
    <h1 class="text-4xl font-bold mb-2">DocPrep</h1>
    <p class="text-text-muted">The PYQ bank AIIMS Patna deserves.</p>
    
    <div class="w-48 h-1 bg-border rounded-full mt-8 overflow-hidden">
      <div class="h-full bg-accent animate-loadbar"></div>
    </div>
  </div>
</div>

<style>
  @keyframes loadbar {
    0% { width: 0%; }
    100% { width: 100%; }
  }
  .animate-loadbar {
    animation: loadbar 1.5s ease-out forwards;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const splash = document.getElementById('splash-screen');
    if (!splash) return;
    
    if (sessionStorage.getItem('splashSeen') === 'true') {
      splash.remove();
      return;
    }
    
    const removeSplash = () => {
      splash.style.opacity = '0';
      setTimeout(() => splash.remove(), 500);
      sessionStorage.setItem('splashSeen', 'true');
    };

    splash.addEventListener('click', removeSplash);
    setTimeout(removeSplash, 1500);
  });
</script>
